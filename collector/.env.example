PORT=3000
LOG_LEVEL=info
STATE_INTERVAL_MS=1000
REST_POLL_MS=5000
SUPABASE_INTERVAL_MS=15000
BOOK_SAMPLE_MS=1000
FLOW_RETENTION_MINUTES=240
EXTERNAL_FAST_MS=30000
EXTERNAL_MEDIUM_MS=120000
EXTERNAL_SLOW_MS=300000
MAX_TRADE_BUFFER=100000
MAX_BOOK_BUFFER=20000
MAX_QUARANTINE_BATCHES=200
CLICKHOUSE_REQUEST_TIMEOUT_MS=10000
CLICKHOUSE_BOOTSTRAP_TIMEOUT_MS=180000

REDIS_URL=redis://default:password@host:6379

CLICKHOUSE_URL=http://host:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=btc

# Supabase is durable storage only. Railway remains the single authoritative engine.
SUPABASE_URL=https://YOUR_BTC_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Broad all-exchange derivatives/spot/liquidation/ETF/on-chain reconciliation.
COINGLASS_API_KEY=

# Official macro/rates/liquidity history (Fed/Treasury/BLS-derived series via FRED).
FRED_API_KEY=

# Optional premium on-chain metrics (MVRV/SOPR/NUPL/STH-LTH, plan dependent).
GLASSNODE_API_KEY=

# Optional commercial consensus/calendar/news providers can be added without
# changing the engine contract. Primary-source actuals remain authoritative.
MACRO_CONSENSUS_API_KEY=
NEWS_API_KEY=
